---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'pt';
const code = (name: string, t: string, h: number) => `<iframe src="${SITE_URL}/embed/${lang}/${name}/" title="${t}" width="100%" height="${h}" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
const items = [
  { name: 'pontes', h2: 'Otimizador de pontes', text: 'Ano, dias de férias e concelho: os seus leitores veem o melhor plano e todas as pontes do ano.', t: 'Otimizador de pontes', h: 980 },
  { name: 'feriado-municipal', h2: 'Feriado municipal do concelho', text: 'Os 308 concelhos: a data do feriado municipal quando está confirmada no sítio da câmara, com a fonte.', t: 'Feriado municipal do concelho', h: 760 },
];
---
<PageLayout title="Pontes e feriados para incorporar no seu sítio, grátis 2027" description="Otimizador de pontes e feriado municipal dos 308 concelhos para incorporar gratuitamente com um iframe: copia o código uma vez, os anos novos chegam sozinhos." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Início', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Incorpore as pontes e os feriados</h1>
    <p class="mt-3 text-lg text-navy-700">Para recursos humanos, sindicatos, associações e jornais locais: copia o código uma vez, os anos novos chegam sozinhos.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    {items.map((i) => (<>
      <h2>{i.h2}</h2>
      <p>{i.text}</p>
      <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code(i.name, i.t, i.h)}</code></pre>
    </>))}
    <p>Para a versão inglesa substitua <code>/embed/pt/</code> por <code>/embed/en/</code>. Condições: a ligação para a fonte por baixo da ferramenta fica visível, a ferramenta não é alterada e é fornecida sem garantia. O que os seus leitores escrevem fica no dispositivo deles. Perguntas pela página de <a href={route('contact', lang)}>contacto</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src={`/embed/${lang}/pontes/`} title="Otimizador de pontes" width="100%" height="980" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
