---
/**
 * Accueil : l'optimiseur de pontes 2027, les repères, la réponse repliée, le corps, les textes longs en accordéons,
 * les familles de pages, les outils en cartes, la FAQ. Texte : src/content/home.ts ; dates : moteur (src/lib/engine).
 */
import PageLayout from '../layouts/PageLayout.astro';
import Clamp from './Clamp.astro';
import Tool from './Tool.astro';
import Body from './Body.astro';
import { HOME } from '../content/home';
import { tabelaAno } from '../lib/bausteine';
import { route, hasRoute, type Locale } from '../i18n/routes';
import { GROUPS } from '../i18n/nav';
import { helpers, sourceList } from '../lib/helpers';
import { GUIDES } from '../lib/pages';
import { faqSchema, organizationSchema, websiteSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
interface Props { lang: Locale }
const { lang } = Astro.props;
const x = HOME[lang];
const path = route('home', lang);
const h = helpers(lang);
const sources = sourceList(HOME.sources, lang);
const jsonLd = [websiteSchema(lang), organizationSchema(lang), webPageSchema({ name: x.h1, description: x.description, path, lang }), webApplicationSchema({ name: x.h1, description: x.description, path, lang }), faqSchema(x.faqs, lang)];
const tools = GUIDES.filter((p) => p.group === 'ferramentas' && hasRoute(p.id, lang));
const more = { pt: 'Como as ferramentas calculam e verificam', en: 'How the tools calculate and check' }[lang];
const allPages = { pt: 'Todas as páginas do sítio', en: 'Every page on the site' }[lang];
const who = { pt: 'Quem publica o sítio', en: 'Who runs this site' }[lang];
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={x.faqs} sources={sources}>
  <header class="mb-4">
    <h1 class="text-[1.7rem] font-bold text-navy-900 max-sm:leading-tight sm:text-3xl md:text-4xl">{x.h1}</h1>
    <p class="mt-2 text-base text-navy-700 sm:text-lg">{x.intro}</p>
    <p class="mt-2 text-sm text-navy-800">{x.datas} <a href="#feriados-2027" class="font-medium text-accent-700 underline">{x.datasLink}</a></p>
  </header>
  <div data-outil data-chrome><Tool kind="pt" lang={lang} idPrefix="home" /></div>
  {/* La liste des 13 feriados juste après l'outil (testeurs naïfs du 2026-11-14, tour 4) : c'est ce que le visiteur vient chercher. */}
  <section id="feriados-2027" class="mt-6 scroll-mt-20"><Body html={tabelaAno(h, 2027)} path={path} lang={lang} /></section>
  {/* Repères en tuiles (testeurs naïfs du 2026-11-14) : les classes « limits » et « fold » n'avaient aucune règle CSS,
      libellés et valeurs s'affichaient à la suite comme du texte brut. */}
  <dl data-chrome class="my-6 grid grid-cols-2 gap-3 text-sm lg:grid-cols-4">
    {x.facts.map((f) => <div class="rounded-lg border border-navy-200 bg-navy-50 px-3 py-2"><dt class="text-navy-700">{f.k}</dt><dd class="mt-0.5 text-base font-semibold text-navy-900 tabular-nums">{f.v}</dd></div>)}
  </dl>
  <Clamp text={x.resume} lang={lang} id="clamp-home" class="my-8" />
  <section class="mt-10"><Body html={x.why(h)} path={path} lang={lang} /></section>
  <section class="mt-10">
    <h2 class="text-2xl font-bold text-navy-900">{x.foldTitle}</h2>
    {x.sections(h).map((s) => <details class="group border-b border-navy-200"><summary class="flex cursor-pointer list-none items-center justify-between gap-3 py-3 [&::-webkit-details-marker]:hidden"><h3 class="text-lg font-semibold text-navy-900">{s.title}</h3><span aria-hidden="true" class="shrink-0 text-xl leading-none text-accent-700 transition-transform group-open:rotate-45">+</span></summary><div class="pb-4"><Body html={s.html} path={path} lang={lang} /></div></details>)}
  </section>
  <section class="mt-10" data-chrome>
    <h2 class="text-2xl font-bold text-navy-900">{allPages}</h2>
    {GROUPS.filter((g) => g.id !== 'ferramentas').map((g) => {
      const list = GUIDES.filter((p) => p.group === g.id && hasRoute(p.id, lang));
      return list.length > 0 && (
        <div class="mb-6">
          <h3 class="mt-5 text-lg font-bold text-navy-900">{g.label[lang]}</h3>
          <ul class="mt-3 grid gap-x-6 gap-y-2 text-sm sm:grid-cols-2 lg:grid-cols-3">
            {list.map((p) => <li><a href={route(p.id, lang)} class="font-medium text-accent-700 underline-offset-2 hover:underline">{p[lang].nav}</a><span class="block text-navy-600">{p[lang].card}</span></li>)}
          </ul>
        </div>
      );
    })}
  </section>
  <section class="mt-10" data-chrome>
    <h2 class="text-2xl font-bold text-navy-900">{x.toolsTitle}</h2>
    <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {tools.map((p) => <li class="rounded-lg border border-navy-200 bg-white p-4"><a href={route(p.id, lang)} class="font-semibold text-accent-700 underline-offset-2 hover:underline">{p[lang].nav}</a><span class="mt-1 block text-sm text-navy-600">{p[lang].card}</span></li>)}
    </ul>
    <p class="mt-4 text-sm text-navy-700"><a href={route('method', lang)} class="font-medium text-accent-700 underline">{more}</a> · <a href={route('about', lang)} class="font-medium text-accent-700 underline">{who}</a></p>
  </section>
</PageLayout>
