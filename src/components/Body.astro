---
/** Le corps HTML d'un fichier de contenu, ses mini-simulateurs (MiniSim de la trame) rendus en îlots. */
import MiniSim from './calc/MiniSim';
import { miniHref } from '../lib/mini-targets';
import { toNum, phraseFixe, exempleMini } from '../lib/mini-specs';
import { getTool } from '../lib/tool-specs';
import type { Lang } from '../lib/format';
interface Props { html: string; path: string; lang: Lang }
const { html, path, lang } = Astro.props;
const parts = html.split(/<!--mini:([A-Za-z0-9_]+)(?:\|([A-Za-z0-9+/=]+))?-->/);
const decode = (b?: string) => (b ? JSON.parse(Buffer.from(b, 'base64').toString('utf8')) as { t?: string; p?: string[]; d?: Record<string, number | string>; c?: string } : {});
const props = (kind: string, b: string | undefined, i: number) => {
  const a = decode(b);
  const ids = getTool(kind, lang).inputs.map((x) => x.id);
  const locked = a.p ? ids.filter((id) => !a.p!.includes(id)) : [];
  // Une phrase courte au lieu de la liste « Já escolhido nesta página : … » (testeurs naïfs du 2026-11-14, tour 2).
  return { title: a.t ?? a.c, defaults: toNum(kind, lang, a.d), locked, idPrefix: `m${i}`, fixe: phraseFixe(kind, lang, a.d, locked), exemple: exempleMini(kind, lang, a.d, locked) || undefined };
};
---
<div class="prose prose-slate max-w-none">
  {parts.map((p, i) => i % 3 === 0 ? <Fragment set:html={p ?? ''} />
    : i % 3 === 1 ? <div data-chrome class="not-prose"><MiniSim client:load kind={p} lang={lang} href={((x) => (x.replace(/\/$/, '') === path.replace(/\/$/, '') ? undefined : x))(miniHref(p, lang, path))} {...props(p, parts[i + 1], i)} /></div>
    : null)}
</div>
